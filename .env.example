# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
BASE_URL=http://127.0.0.1:8000

# Database (PostgreSQL - recommended for production)
DB_NAME=saia_insurance
DB_USER=saia_user
DB_PASSWORD=saia_password_2025
DB_HOST=localhost
DB_PORT=5433

# Use SQLite instead (for quick local testing only)
# USE_SQLITE=True

# MongoDB (for sessions)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=saia_sessions

# Redis (for cache and Celery)
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Configuration
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key
GEMINI_API_KEY=your-gemini-api-key-here

# WhatsApp Configuration
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_VERIFY_TOKEN=your-verify-token

# Payment Gateways
MOYASAR_API_KEY=your-moyasar-api-key
HYPERPAY_ACCESS_TOKEN=your-hyperpay-token
